<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All post</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <h1>Quora Post</h1>
    <% for(let post of posts){ %>
        <div class="post">
            <h3 class="user">@<%=post.username %></h3>
            <h4 class="content"><%=post.content %></h3>
            <br>
            <a href="http://localhost:8080/posts/<%=post.id%>"> <%=post.id %> See in Details</a>
            <a href="http://localhost:8080/posts/<%=post.id%>/edit"> <%=post.id %>Edit</a>
            <br>
            <br>
            <form method="post" action="/posts/<%=post.id %>?_method=DELETE">
                <button>Delete Post</button>
            </form>
            

        </div>
    <%}%>

    <br>
    <a href="http://localhost:8080/posts/new"> Click here to add post</a>
</body>
</html>